import Foundation

// Personal build config — not shipped, not committed.
//
// Copy this file to `Secrets.swift` (same folder) and put your own TMDB key
// in it. `Secrets.swift` is in .gitignore, so it never reaches the public
// repo or anyone else's clone; Xcode picks it up automatically because this
// project uses file-system-synced groups (any .swift file dropped into
// NuviOS/ is compiled in, no project-file edit needed).
//
// Nothing breaks without it — `TmdbSettings.effectiveAPIKey` falls back to
// whatever the viewer types into Settings, exactly as before. This just
// saves you from typing your own key in there every time you reinstall.
enum Secrets {
    static let tmdbAPIKey = ""
}
